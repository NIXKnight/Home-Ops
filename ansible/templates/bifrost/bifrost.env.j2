# {{ ansible_managed }}
# Bifrost gateway environment (docker-compose env_file).
#
# Rendered 0600 root by playbooks/ai-hosts.yml --tags bifrost through the role's
# templates interface (BIFROST_COMPOSE_SERVICE_TEMPLATES, item no_log: true), so
# the render feeds the role's own change-detection and a credential rotation both
# re-renders this file and restarts the unit in one run.
#
# Values are consumed with `format: raw` (docker compose >= v2.30), which disables
# interpolation of the env_file contents — every value ships literally, with no
# `$`-doubling, which matters because generated passwords and keys routinely
# contain `$`.
#
# Every name below is either read by the image's own entrypoint or referenced from
# config.json as `env.<NAME>`; nothing here is invented. Non-secret values come
# from the Internal config-bifrost.yml, secrets from secrets-bifrost.yml.

# --- Entrypoint contract ----------------------------------------------------
# The image starts /app/main -app-dir "$APP_DIR" -port "$APP_PORT" -host
# "$APP_HOST" -log-level "$LOG_LEVEL" -log-style "$LOG_STYLE", so these five are
# the supported way to configure the process on a container platform. APP_HOST is
# 0.0.0.0 because the listener is reached through the published port, not from
# inside the container. APP_DIR is the image's declared VOLUME and holds
# config.json plus the SQLite config and logs stores.
APP_HOST={{ BIFROST_APP_HOST }}
APP_PORT={{ BIFROST_PORT }}
APP_DIR={{ BIFROST_APP_DIR }}
LOG_LEVEL={{ BIFROST_LOG_LEVEL }}
LOG_STYLE={{ BIFROST_LOG_STYLE }}

# --- Go runtime -------------------------------------------------------------
# GOMAXPROCS is derived from the cgroup CPU quota by automaxprocs and is not set
# here. GOMEMLIMIT is a soft ceiling for the Go heap and is the one knob worth
# pinning on a box whose real memory pressure comes from the vLLM process next
# door: it keeps the gateway's heap bounded instead of letting it grow into RAM
# the inference server needs.
GOGC={{ BIFROST_GOGC }}
GOMEMLIMIT={{ BIFROST_GOMEMLIMIT }}

# --- Configuration secrets (referenced from config.json as env.<NAME>) -------
# BIFROST_ENCRYPTION_KEY protects credentials persisted into the config store.
# It CANNOT be rotated without wiping the store, so treat it as permanent for the
# life of the bifrost_data volume.
BIFROST_ENCRYPTION_KEY={{ BIFROST_ENCRYPTION_KEY }}

# BIFROST_SETUP_TOKEN IS DELIBERATELY NOT RENDERED. The pinned v1.6.10 has no
# setup-token mechanism of any kind — the name appears nowhere in its config
# structs, its loader or its environment handling. It is a 2.x addition, and the
# earlier claim here that "Bifrost refuses to create the first account unless this
# token is configured" was wrong for this version: the first admin account comes
# from governance.auth_config in config.json, reconciled into the config store on
# every start. Exporting the token would have been a secret in a process
# environment for no reader.
#
# The vaulted BIFROST_SETUP_TOKEN in secrets-bifrost.yml is left in place, unused,
# so the value does not have to be re-minted when the pin moves to 2.x. Restore
# this line at that point, not before.
{%- if BIFROST_AUTH_ENABLED | bool %}

# Dashboard and admin-API credentials, referenced by governance.auth_config in
# config.json. Rendered only while BIFROST_AUTH_ENABLED is true.
BIFROST_ADMIN_USERNAME={{ BIFROST_ADMIN_USERNAME }}
BIFROST_ADMIN_PASSWORD={{ BIFROST_ADMIN_PASSWORD }}
{%- endif %}
{%- if BIFROST_EXTRA_ENVIRONMENT | default({}) | length > 0 %}

# --- Extra runtime environment ----------------------------------------------
# Free-form passthrough from the Internal BIFROST_EXTRA_ENVIRONMENT map. Use it
# for provider API keys that config.json references as `env.<NAME>` (an
# OPENAI_API_KEY or ANTHROPIC_API_KEY once those exist) without editing this
# template. Values land in a 0600 no_log file, so vaulted material is safe here.
{%- for key, value in BIFROST_EXTRA_ENVIRONMENT.items() %}
{{ key }}={{ value }}
{%- endfor %}
{%- endif %}
