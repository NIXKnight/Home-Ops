# {{ ansible_managed }}
# vLLM service environment (docker-compose env_file).
#
# Rendered 0600 root by playbooks/ai-hosts.yml --tags vllm through the role's
# templates interface (VLLM_COMPOSE_SERVICE_TEMPLATES, item no_log: true), so the
# render feeds the role's own change-detection: rotating the token or flipping a
# knob below re-renders this file AND restarts the unit in the same run.
#
# Values are consumed with `format: raw` (docker compose >= v2.30), which disables
# interpolation of the env_file contents — every value here ships literally, with
# no `$`-doubling.
#
# Non-secret knobs come from the Internal config-vllm.yml; the only secret this
# file can carry is the HuggingFace token from secrets-vllm.yml.

# --- Plugin ALLOWLIST -------------------------------------------------------
# VLLM_PLUGINS is an allowlist, not an addition. Naming one plugin silently
# disables every other one, so the three this image ships — the out-of-tree GGUF
# loader, the bitsandbytes quantization/loader override, and vLLM's in-tree LoRA
# filesystem resolver — must be listed together or two of them quietly vanish.
# See the foot of docker/vllm/Dockerfile.
VLLM_PLUGINS={{ VLLM_PLUGINS }}

# --- HuggingFace cache ------------------------------------------------------
# Points at the bind-mounted host cache directory so a repo pulled once survives
# container recreation. `repo_id:quant_type` model references (the GGUF plugin's
# load path) download into this cache, not into the models bind mount, which is
# reserved for locally staged .gguf files.
HF_HOME={{ VLLM_HF_CACHE_CONTAINER_DIR }}

# --- Healthcheck port -------------------------------------------------------
# Read ONLY by the image's baked-in HEALTHCHECK (curl /health), and deliberately
# NOT named VLLM_* because vLLM rejects unrecognised members of its own VLLM_
# namespace. Keep it in lockstep with the --port serve flag or the probe lies.
HEALTHCHECK_PORT={{ VLLM_PORT }}
{%- if VLLM_HF_TOKEN | length > 0 %}

# --- HuggingFace token ------------------------------------------------------
# Only needed for gated or private repos. Rendered exclusively when the vaulted
# VLLM_HF_TOKEN is non-empty: huggingface_hub sends whatever token it finds, so
# an empty or placeholder value would turn public downloads into 401s.
HF_TOKEN={{ VLLM_HF_TOKEN }}
{%- endif %}
{%- if VLLM_NVIDIA_DISABLE_REQUIRE | bool %}

# --- Legacy-hook escape hatch -----------------------------------------------
# Clears the base image's NVIDIA_REQUIRE_CUDA driver clauses. This host's 610.x
# branch trips them under the legacy nvidia-container-runtime hook but NOT under
# CDI, which is the path this deployment uses — so this stays off unless the
# deployment is moved back onto `runtime: nvidia`.
NVIDIA_DISABLE_REQUIRE=1
{%- endif %}
{%- if VLLM_EXTRA_ENVIRONMENT | default({}) | length > 0 %}

# --- Extra runtime environment ----------------------------------------------
# Free-form passthrough from the Internal VLLM_EXTRA_ENVIRONMENT map, so the
# runtime toggles documented at the foot of docker/vllm/Dockerfile — LMCACHE_*
# for CPU/disk KV offload, VLLM_LORA_RESOLVER_CACHE_DIR for the LoRA resolver,
# VLLM_GGUF_USE_CUDA=0 to fall back to the plugin's Triton kernels — can be added
# without editing this template.
{%- for key, value in VLLM_EXTRA_ENVIRONMENT.items() %}
{{ key }}={{ value }}
{%- endfor %}
{%- endif %}
